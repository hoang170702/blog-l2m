# Copy to frontend/.env.local for `npm run dev`. Both values are public by design
# (access is enforced by row-level security); hosted values live in GitLab CI/CD variables.

# Local stack from `npx supabase start` at the repository root.
VITE_SUPABASE_URL=http://127.0.0.1:54321
# The "anon key" (or "Publishable key") printed by `npx supabase status`.
VITE_SUPABASE_ANON_KEY=
