# Local development environment. Copy to `.env` and adjust.
# Never commit a real `.env`; production values live in GitLab CI/CD variables.

# --- PostgreSQL (local container) ---
# Keep the major version in sync with the production Supabase project.
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_USER=blog
POSTGRES_PASSWORD=change-me
POSTGRES_DB=blog

# Runtime connection (Supabase: transaction pooler, port 6543).
DATABASE_URL=postgresql://blog:change-me@localhost:5432/blog
# Migration connection (Supabase: session pooler, port 5432).
DIRECT_URL=postgresql://blog:change-me@localhost:5432/blog

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# --- HTTP ---
PORT=3000
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
