# Copy to supabase/.env (git-ignored); `npx supabase start` reads it for config.toml env(...) values.
# Create the OAuth apps with callback URL http://127.0.0.1:54321/auth/v1/callback:
#   Google: https://console.cloud.google.com/apis/credentials (OAuth client ID, type "Web application")
#   GitHub: https://github.com/settings/developers (New OAuth App)
# Google is already enabled in config.toml; for GitHub set `enabled = true` under [auth.external.github].
# Restart after editing this file: npx supabase stop && npx supabase start
# Full Google steps (consent screen, client, cloud projects): plans/2026-11-23-no1-blog-monorepo/phases/P12-multi-author-oauth.md
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
