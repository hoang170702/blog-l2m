# Template for deploy/vars/uat.env and deploy/vars/production.env (git-ignored, chmod 600).
# Load with: deploy/scripts/set-gitlab-vars.sh <uat|production> [--generate-secrets]
# No quotes; values must not contain single quotes.

# Server access (same values in both environments)
DEPLOY_HOST=203.0.113.10
DEPLOY_USER=deploy
SSH_KNOWN_HOSTS=203.0.113.10 ssh-ed25519 AAAA...
SSH_PRIVATE_KEY_FILE=~/.ssh/blog_deploy

# This environment
DEPLOY_PATH=/opt/blog-uat
APP_DOMAIN=uat.example.com

# Supabase project of this environment
DATABASE_URL=postgresql://postgres.PROJECTREF:change-me@aws-0-REGION.pooler.supabase.com:6543/postgres?uselibpqcompat=true&sslmode=require
DIRECT_URL=postgresql://postgres.PROJECTREF:change-me@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
