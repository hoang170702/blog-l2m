# Keys rendered into /opt/blog-<env>/.env by the deploy job from GitLab CI/CD variables.
# Placeholders only. Never commit real values.

# --- Stack identity ---
COMPOSE_PROJECT_NAME=blog-uat            # blog-uat | blog-prod
APP_DOMAIN=uat.example.com               # example.com for production
REGISTRY_IMAGE=registry.gitlab.com/group/project
IMAGE_TAG=0123abcd                        # commit short SHA, set by the pipeline

# --- Registry pull credentials (GitLab deploy token, read_registry) ---
DEPLOY_REGISTRY_USER=gitlab+deploy-token-0
DEPLOY_REGISTRY_PASSWORD=change-me

# --- Database (Supabase) ---
# Runtime: transaction pooler (port 6543). Keep connection_limit small.
DATABASE_URL=postgresql://postgres.PROJECTREF:change-me@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&sslmode=require
# Migrations: session pooler (port 5432).
DIRECT_URL=postgresql://postgres.PROJECTREF:change-me@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Interim self-hosted database instead of Supabase:
#   COMPOSE_PROFILES=selfhost-db
#   POSTGRES_PASSWORD=change-me
#   DATABASE_URL=postgresql://blog:change-me@postgres:5432/blog
#   DIRECT_URL=postgresql://blog:change-me@postgres:5432/blog
COMPOSE_PROFILES=

# --- Secrets (generate: openssl rand -hex 32) ---
REDIS_PASSWORD=change-me
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars

# --- Admin account (created or updated on every deploy) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
